# gh-proxy configuration
# Copy this file to .env and adjust. Real environment variables take
# precedence over values in .env.

# Port the proxy listens on.
PORT=8788

# Interface to bind. 0.0.0.0 = accept connections from other machines.
BIND_HOST=0.0.0.0

# Hostname (and port) that CLIENT machines use to reach this proxy.
# Used to rewrite Link/Location headers and JSON body URLs so that
# pagination and follow-up requests keep flowing through the proxy.
# Scheme is optional (defaults to http://, or https:// when TLS is on).
# Examples:  my-pc.example.internal:8788   /   http://192.168.0.10:8788
PUBLIC_HOST=localhost:8788

# Optional shared secret. When set, every proxied request must carry it:
#   - CONNECT / forward proxy : HTTPS_PROXY=http://user:<token>@host:port
#   - reverse proxy (REST etc): "X-Proxy-Token: <token>" header
# Leave empty to disable (trusted LAN).
PROXY_TOKEN=

# Optional GitHub token injected server-side into /api/v3, /api/graphql and
# /api/uploads requests that arrive WITHOUT an Authorization header.
# Convenient, but combine with PROXY_TOKEN — otherwise anyone who can reach
# this proxy can act with this token. Never used for CONNECT tunnels.
GITHUB_TOKEN=

# Rewrite https://api.github.com / https://uploads.github.com URLs inside
# JSON response bodies (and Link/Location headers) to PUBLIC_HOST.
REWRITE_BODY_URLS=true

# Follow GitHub redirects (e.g. tarball -> codeload.github.com) on the server
# so clients never have to reach hosts they cannot resolve.
FOLLOW_REDIRECTS=true
MAX_REDIRECTS=5

# Timeouts (milliseconds).
UPSTREAM_TIMEOUT_MS=30000
CONNECT_TIMEOUT_MS=10000

# Extra hosts allowed for CONNECT tunneling, comma separated.
# Supports "*." wildcards, e.g.:  *.example.com,registry.npmjs.org
EXTRA_ALLOWED_HOSTS=

# Request logging to stdout.
LOG_REQUESTS=true

# Optional TLS for the proxy itself (needed for GH_HOST/GHES-emulation mode;
# the CONNECT mode works fine over plain HTTP).
TLS_CERT_FILE=
TLS_KEY_FILE=
